"""Hand-eye calibration for the PAROL6 with the XIAO ESP32S3 Sense camera.

Workflow
--------
1. Tape the printed ChArUco board to a flat, fixed surface in the workspace.
2. Run this script. A live camera window opens (same un-mirroring + ArUco
   detection as the calibration viewer).
3. Move the arm to a varied pose where the camera sees the whole board, hold
   still, then either:
     * press 'c' in the camera window to capture using the joint angles
       read live from the PAROL6 (requires the ``parol6`` Python package and
       a running controller / connected arm), or
     * type the 6 joint angles in degrees into the terminal and press ENTER
       (manual fallback when the package is unavailable).
   The script captures a sample (board pose in camera frame + robot FK pose)
   and prints how many samples have been collected.
4. Repeat for >= 15 poses. Vary translation AND rotation. Tilt the camera
   strongly between captures - hand-eye calibration is degenerate without
   rotational diversity.
5. Press 's' in the camera window to solve and save the result, or 'q' to
   quit without solving.

Output
------
Writes ``hand_eye.npz`` next to this script with:
  - T_cam_gripper : 4x4 homogeneous transform, camera frame -> gripper frame.
  - method        : the cv2.calibrateHandEye method name used.
  - rvec, tvec    : Rodrigues rotation and translation for convenience.
  - n_samples     : number of poses used.
  - rms_residual  : average rotation+translation residual over the input set.

Conventions
-----------
- Translations are stored in METERS to match the ChArUco board sizes
  (SQUARE_LENGTH_M = 0.022 m, MARKER_LENGTH_M = 0.016 m). PAROL6 joint angles
  are entered in DEGREES.
- The DH parameters below are the project defaults from the PAROL6 firmware /
  PAROL-commander-software. They MUST be verified against your own arm before
  trusting the result. If your FK does not match the real robot pose, the
  hand-eye solve will be garbage.
"""

from __future__ import annotations

import os
import sys
import threading
import time
from dataclasses import dataclass, field
from pathlib import Path

import cv2
import numpy as np

# Reuse the serial camera, ChArUco constants, and intrinsics from the existing viewer.
sys.path.insert(0, str(Path(__file__).resolve().parent))
from usb_serial_camera_viewer import (  # noqa: E402
    CHARUCO_DICT,
    MARKER_LENGTH_M,
    SQUARES_X,
    SQUARES_Y,
    SQUARE_LENGTH_M,
    SerialCamera,
)

from parol6 import Robot as _Parol6Robot, RobotClient as _Parol6Client  # type: ignore
_PAROL6_AVAILABLE = True



_SCRIPT_DIR = Path(__file__).resolve().parent
_REPO_ROOT = _SCRIPT_DIR.parent


@dataclass
class Settings:
    """All tunables for the hand-eye calibration run. Edit values here."""

    # --- Camera (XIAO ESP32S3 Sense over USB serial) ---
    camera_port: str = "/dev/tty.usbmodem101"
    camera_baud: int = 921600
    camera_timeout_s: float = 2.0
    camera_framesize: str = "UXGA"
    camera_jpeg_quality: int = 8  # lower number = higher quality

    # --- Files ---
    intrinsics_path: Path = field(default_factory=lambda: _SCRIPT_DIR / "intrinsics.npz")
    output_path: Path = field(default_factory=lambda: _REPO_ROOT / "hand_eye.npz")

    # --- UI ---
    window_name: str = "Hand-Eye Calibration"
    min_samples: int = 15

    # --- PAROL6 (optional, ignored if the parol6 package is not installed) ---
    parol6_serial_port: str = "/dev/tty.usbmodem308A388234331"
    parol6_host: str = "127.0.0.1"
    parol6_port: int = 5001
    parol6_client_timeout_s: float = 2.0
    parol6_ready_timeout_s: float = 5.0


# Edit this instance to change the run configuration.
SETTINGS = Settings()

# ---------------------------------------------------------------------------
# PAROL6 forward kinematics
# ---------------------------------------------------------------------------
# Modified Denavit-Hartenberg parameters as published in the PAROL-commander
# software (PAROL6_kinematics.py). Order: joint 1 .. joint 6.
#   alpha_{i-1} [rad], a_{i-1} [m], d_i [m], theta_offset_i [rad]
# IMPORTANT: verify these against the firmware version you flashed; the
# project has revised them at least once.
PAROL6_DH = np.array(
    [
        # alpha_{i-1},        a_{i-1} [m], d_i [m],  theta_offset [rad]
        [0.0,                 0.0,         0.1105,   0.0],                # J1
        [-np.pi / 2,          0.0,         0.0,      -np.pi / 2],         # J2
        [0.0,                 0.180,       0.0,      0.0],                # J3
        [-np.pi / 2,          0.0,         0.17655,  0.0],                # J4
        [np.pi / 2,           0.0,         0.0,      0.0],                # J5
        [-np.pi / 2,          0.0,         0.06542,  0.0],                # J6 (flange)
    ],
    dtype=float,
)


def _dh_transform(alpha: float, a: float, d: float, theta: float) -> np.ndarray:
    """Modified-DH single-link homogeneous transform."""
    ca, sa = np.cos(alpha), np.sin(alpha)
    ct, st = np.cos(theta), np.sin(theta)
    return np.array(
        [
            [ct,      -st,     0.0,    a],
            [st * ca, ct * ca, -sa,   -sa * d],
            [st * sa, ct * sa,  ca,    ca * d],
            [0.0,     0.0,     0.0,    1.0],
        ],
        dtype=float,
    )


def parol6_fk(joint_angles_deg: np.ndarray, robot: object | None = None) -> np.ndarray:
    """Forward kinematics: 6 joint angles in degrees -> T_base_gripper (4x4, meters).

    If a ``parol6.Robot`` instance is supplied, its built-in FK (which uses the
    canonical kinematic model from the official Python API) is used. Otherwise
    falls back to the local DH chain above.
    """
    if joint_angles_deg.shape != (6,):
        raise ValueError(f"Expected 6 joint angles, got shape {joint_angles_deg.shape}")
    if robot is not None and hasattr(robot, "fk"):
        try:
            T = np.asarray(robot.fk(joint_angles_deg.tolist()), dtype=float)
            if T.shape == (4, 4):
                return T
        except Exception as exc:
            print(f"  warning: parol6 FK failed ({exc}); using local DH chain.")
    thetas = np.deg2rad(joint_angles_deg)
    T = np.eye(4)
    for i in range(6):
        alpha, a, d, off = PAROL6_DH[i]
        T = T @ _dh_transform(alpha, a, d, thetas[i] + off)
    return T


# ---------------------------------------------------------------------------
# Sample collection
# ---------------------------------------------------------------------------
@dataclass
class Sample:
    joints_deg: np.ndarray            # (6,)
    T_base_gripper: np.ndarray        # (4, 4)
    rvec_target_cam: np.ndarray       # (3, 1)
    tvec_target_cam: np.ndarray       # (3, 1)


def load_intrinsics() -> tuple[np.ndarray, np.ndarray]:
    path = SETTINGS.intrinsics_path
    if not path.exists():
        raise SystemExit(
            f"Intrinsics file not found at {path}. Run the camera"
            " calibration first."
        )
    data = np.load(path)
    return data["intrinsics"], data["distortion"]


def make_detector() -> tuple[cv2.aruco.ArucoDetector, cv2.aruco.CharucoBoard, cv2.CLAHE]:
    dictionary = cv2.aruco.getPredefinedDictionary(CHARUCO_DICT)
    board = cv2.aruco.CharucoBoard(
        (SQUARES_X, SQUARES_Y), SQUARE_LENGTH_M, MARKER_LENGTH_M, dictionary
    )
    params = cv2.aruco.DetectorParameters()
    params.adaptiveThreshWinSizeMin = 5
    params.adaptiveThreshWinSizeMax = 45
    params.adaptiveThreshWinSizeStep = 4
    params.minMarkerPerimeterRate = 0.01
    params.cornerRefinementMethod = cv2.aruco.CORNER_REFINE_SUBPIX
    if hasattr(params, "useAruco3Detection"):
        params.useAruco3Detection = True
    detector = cv2.aruco.ArucoDetector(dictionary, params)
    clahe = cv2.createCLAHE(clipLimit=3.0, tileGridSize=(8, 8))
    return detector, board, clahe


def estimate_board_pose(
    frame: np.ndarray,
    detector: cv2.aruco.ArucoDetector,
    board: cv2.aruco.CharucoBoard,
    clahe: cv2.CLAHE,
    K: np.ndarray,
    dist: np.ndarray,
) -> tuple[np.ndarray | None, np.ndarray | None, int, int, np.ndarray | None, np.ndarray | None]:
    """Detect ChArUco corners and run solvePnP. Returns (rvec, tvec, n_corners, n_markers, corners, ids)."""
    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    gray = clahe.apply(gray)
    marker_corners, marker_ids, _ = detector.detectMarkers(gray)
    if marker_ids is None or len(marker_ids) == 0:
        return None, None, 0, 0, None, None
    _, corners, ids = cv2.aruco.interpolateCornersCharuco(
        marker_corners, marker_ids, gray, board
    )
    n_corners = 0 if ids is None else len(ids)
    if n_corners < 6:
        return None, None, n_corners, len(marker_ids), corners, ids
    obj_pts, img_pts = board.matchImagePoints(corners, ids)
    if obj_pts is None or len(obj_pts) < 6:
        return None, None, n_corners, len(marker_ids), corners, ids
    ok, rvec, tvec = cv2.solvePnP(
        obj_pts, img_pts, K, dist, flags=cv2.SOLVEPNP_ITERATIVE
    )
    if not ok:
        return None, None, n_corners, len(marker_ids), corners, ids
    return rvec, tvec, n_corners, len(marker_ids), corners, ids


# ---------------------------------------------------------------------------
# Joint angle prompt (runs on a worker thread so the UI loop stays responsive)
# ---------------------------------------------------------------------------
class JointPrompt:
    """Background reader for joint angles typed into the terminal."""

    def __init__(self) -> None:
        self._lock = threading.Lock()
        self._pending: np.ndarray | None = None
        self._stop = threading.Event()
        self._thread = threading.Thread(target=self._run, daemon=True)
        self._thread.start()

    def _run(self) -> None:
        while not self._stop.is_set():
            try:
                line = input(
                    "\nEnter 6 joint angles in degrees (J1 J2 J3 J4 J5 J6),"
                    " or 'skip' to abort this sample: "
                )
            except EOFError:
                self._stop.set()
                return
            line = line.strip().lower()
            if line in {"q", "quit", "exit"}:
                self._stop.set()
                return
            if line in {"skip", ""}:
                with self._lock:
                    self._pending = None
                continue
            try:
                values = [float(x) for x in line.replace(",", " ").split()]
                if len(values) != 6:
                    raise ValueError
                angles = np.asarray(values, dtype=float)
            except ValueError:
                print("  -> need exactly 6 numeric values, try again.")
                continue
            with self._lock:
                self._pending = angles
            # wait until the main loop consumed it
            while not self._stop.is_set():
                with self._lock:
                    if self._pending is None:
                        break
                time.sleep(0.05)

    def take(self) -> np.ndarray | None:
        with self._lock:
            angles = self._pending
            self._pending = None
        return angles

    def stop(self) -> None:
        self._stop.set()


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
def solve_and_save(samples: list[Sample]) -> None:
    if len(samples) < 5:
        raise SystemExit(f"Need at least 5 samples to solve, have {len(samples)}.")

    R_gripper2base: list[np.ndarray] = []
    t_gripper2base: list[np.ndarray] = []
    R_target2cam: list[np.ndarray] = []
    t_target2cam: list[np.ndarray] = []

    for s in samples:
        # cv2.calibrateHandEye expects gripper -> base (i.e., the inverse of
        # what FK gives us if FK returns base -> gripper). PAROL6 FK above
        # returns T_base_gripper, so invert it.
        T_b_g = s.T_base_gripper
        R_bg = T_b_g[:3, :3]
        t_bg = T_b_g[:3, 3]
        R_gb = R_bg.T
        t_gb = -R_gb @ t_bg
        R_gripper2base.append(R_bg)
        t_gripper2base.append(t_bg.reshape(3, 1))
        R_tc, _ = cv2.Rodrigues(s.rvec_target_cam)
        R_target2cam.append(R_tc)
        t_target2cam.append(s.tvec_target_cam.reshape(3, 1))

    method = cv2.CALIB_HAND_EYE_PARK
    R_cam2gripper, t_cam2gripper = cv2.calibrateHandEye(
        R_gripper2base, t_gripper2base, R_target2cam, t_target2cam, method=method
    )

    T_cam_gripper = np.eye(4)
    T_cam_gripper[:3, :3] = R_cam2gripper
    T_cam_gripper[:3, 3] = t_cam2gripper.flatten()

    # Residual: AX = XB consistency. Compare T_b_g_i * X * T_t_c_i^-1 vs the
    # same quantity for sample 0 (should be the constant T_base_target).
    T_base_target_ref = None
    rot_errs: list[float] = []
    trans_errs: list[float] = []
    for s in samples:
        T_t_c = np.eye(4)
        R_tc, _ = cv2.Rodrigues(s.rvec_target_cam)
        T_t_c[:3, :3] = R_tc
        T_t_c[:3, 3] = s.tvec_target_cam.flatten()
        T_c_t = np.linalg.inv(T_t_c)
        T_b_t = s.T_base_gripper @ T_cam_gripper @ T_c_t
        if T_base_target_ref is None:
            T_base_target_ref = T_b_t
            continue
        delta = np.linalg.inv(T_base_target_ref) @ T_b_t
        rot_errs.append(np.degrees(np.arccos(np.clip((np.trace(delta[:3, :3]) - 1) / 2, -1, 1))))
        trans_errs.append(np.linalg.norm(delta[:3, 3]))

    rms_rot = float(np.sqrt(np.mean(np.square(rot_errs)))) if rot_errs else 0.0
    rms_trans = float(np.sqrt(np.mean(np.square(trans_errs)))) if trans_errs else 0.0

    rvec, _ = cv2.Rodrigues(R_cam2gripper)
    np.savez(
        SETTINGS.output_path,
        T_cam_gripper=T_cam_gripper,
        rvec=rvec,
        tvec=t_cam2gripper,
        method="PARK",
        n_samples=len(samples),
        rms_rotation_deg=rms_rot,
        rms_translation_m=rms_trans,
    )
    print("\n=== Hand-eye calibration result ===")
    print("T_cam_gripper (4x4, meters):")
    print(np.array2string(T_cam_gripper, precision=5, suppress_small=True))
    print(f"Translation cam->gripper: {t_cam2gripper.flatten()} m")
    print(f"Samples used: {len(samples)}")
    print(f"Consistency residual: rotation RMS={rms_rot:.3f} deg, translation RMS={rms_trans*1000:.2f} mm")
    print(f"Saved to {SETTINGS.output_path.resolve()}")


def _connect_parol6() -> tuple[object | None, object | None]:
    """Try to start the PAROL6 controller and return (robot, client). Returns (None, None) on failure."""
    if not _PAROL6_AVAILABLE:
        print("parol6 package not installed - falling back to manual joint entry.")
        print("  Install with:  pip install parol6   (then read parol6_python_tutorial.md)\n")
        return None, None
    try:
        os.environ["PAROL6_COM_PORT"] = SETTINGS.parol6_serial_port
        robot = _Parol6Robot(host=SETTINGS.parol6_host, port=SETTINGS.parol6_port, normalize_logs=True)  # type: ignore
        robot.start()
        client = _Parol6Client(host=SETTINGS.parol6_host, port=SETTINGS.parol6_port, timeout=SETTINGS.parol6_client_timeout_s)  # type: ignore
        client.__enter__()
        if not client.wait_ready(timeout=SETTINGS.parol6_ready_timeout_s):
            print("PAROL6 controller did not become ready - falling back to manual entry.")
            client.__exit__(None, None, None)
            robot.stop()
            return None, None
        print(f"PAROL6 controller ready at {SETTINGS.parol6_host}:{SETTINGS.parol6_port}.")
        try:
            angles = client.angles()
            print(f"  current joint angles (deg): {[round(float(a), 2) for a in angles]}")
        except Exception as exc:
            print(f"  warning: could not read initial angles ({exc}).")
        return robot, client
    except Exception as exc:
        print(f"Could not start PAROL6 controller ({exc}) - falling back to manual entry.\n")
        return None, None


def _disconnect_parol6(robot: object | None, client: object | None) -> None:
    if client is not None:
        try:
            client.__exit__(None, None, None)
        except Exception:
            pass
    if robot is not None:
        try:
            robot.stop()
        except Exception:
            pass


def main() -> None:
    K, dist = load_intrinsics()
    detector, board, clahe = make_detector()

    samples: list[Sample] = []

    parol6_robot, parol6_client = _connect_parol6()
    use_robot_readback = parol6_client is not None
    prompt = None if use_robot_readback else JointPrompt()

    print(__doc__)
    print(f"Loaded intrinsics from {SETTINGS.intrinsics_path}")
    print(f"Camera serial port: {SETTINGS.camera_port}")
    if use_robot_readback:
        print("Controls in the camera window: 'c' = capture (reads angles from PAROL6),"
              " 's' = solve+save, 'q' = quit, 'x' = drop last sample.\n")
    else:
        print("Controls in the camera window: 's' = solve+save, 'q' = quit, 'x' = drop last sample.")
        print("Type joint angles in this terminal whenever the live preview shows the board with green corners.\n")

    with SerialCamera(
        port=SETTINGS.camera_port,
        baud=SETTINGS.camera_baud,
        timeout=SETTINGS.camera_timeout_s,
        framesize=SETTINGS.camera_framesize,
        window_name=SETTINGS.window_name,
    ) as camera:
        camera.send_command(f"SET QUALITY {SETTINGS.camera_jpeg_quality}")
        camera.set_streaming(True)

        # Show a placeholder immediately so the window actually paints on macOS
        # (cv2.namedWindow alone only draws the title bar).
        placeholder = np.zeros((480, 640, 3), dtype=np.uint8)
        cv2.putText(
            placeholder,
            "Waiting for first frame from camera...",
            (20, 240),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.7,
            (200, 200, 200),
            2,
        )
        cv2.imshow(SETTINGS.window_name, placeholder)
        cv2.waitKey(1)

        latest_lock = threading.Lock()
        latest_raw: list[np.ndarray | None] = [None]
        reader_stop = threading.Event()
        reader_error: list[BaseException | None] = [None]

        def reader_loop() -> None:
            while not reader_stop.is_set():
                try:
                    f, _, _, _ = camera.read()
                except (TimeoutError, RuntimeError) as exc:
                    reader_error[0] = exc
                    time.sleep(0.05)
                    continue
                except BaseException as exc:  # surface unexpected failures
                    reader_error[0] = exc
                    return
                with latest_lock:
                    latest_raw[0] = f

        reader_thread = threading.Thread(target=reader_loop, daemon=True)
        reader_thread.start()

        last_pose: tuple[np.ndarray, np.ndarray] | None = None

        def capture_from_robot() -> None:
            if parol6_client is None:
                print("  -> 'c' pressed but PAROL6 client is not connected.")
                return
            if not detected_state["ok"] or last_pose is None:
                print("  -> 'c' pressed but the board is not currently detected.")
                return
            try:
                angles = np.asarray(parol6_client.angles(), dtype=float)
            except Exception as exc:
                print(f"  -> failed to read joint angles from PAROL6: {exc}")
                return
            if angles.shape != (6,):
                print(f"  -> PAROL6 returned {angles.shape} angles, expected 6.")
                return
            T_bg = parol6_fk(angles, robot=parol6_robot)
            rv, tv = last_pose
            samples.append(
                Sample(
                    joints_deg=angles.copy(),
                    T_base_gripper=T_bg,
                    rvec_target_cam=rv.copy(),
                    tvec_target_cam=tv.copy(),
                )
            )
            print(
                f"  -> sample {len(samples)} captured (live). "
                f"angles deg: {angles.round(2).tolist()}, "
                f"gripper xyz (mm): {(T_bg[:3,3]*1000).round(1).tolist()}, "
                f"board dist: {np.linalg.norm(tv)*1000:.1f} mm"
            )

        detected_state = {"ok": False}
        last_error_print_at = 0.0
        try:
            while True:
                with latest_lock:
                    raw = latest_raw[0]
                    latest_raw[0] = None

                # Surface any background camera errors (every 2s max).
                err = reader_error[0]
                if err is not None and time.time() - last_error_print_at > 2.0:
                    print(f"  [camera] {type(err).__name__}: {err}")
                    last_error_print_at = time.time()
                    reader_error[0] = None
                if not reader_thread.is_alive() and raw is None:
                    print("  [camera] reader thread died; exiting.")
                    break

                # Pull a typed joint-angle entry (only used in fallback mode).
                pending_angles = prompt.take() if prompt is not None else None

                if raw is None:
                    key = cv2.waitKey(15) & 0xFF
                    if key == ord("q"):
                        break
                    if key == ord("s"):
                        solve_and_save(samples)
                        return
                    if key == ord("c"):
                        capture_from_robot()
                    if key == ord("x") and samples:
                        samples.pop()
                        print(f"Dropped last sample, now {len(samples)} remaining.")
                    continue

                frame = cv2.flip(raw, 1)
                rvec, tvec, n_corners, n_markers, corners, ids = estimate_board_pose(
                    frame, detector, board, clahe, K, dist
                )
                display = frame.copy()
                if ids is not None:
                    cv2.aruco.drawDetectedCornersCharuco(display, corners, ids)
                if rvec is not None:
                    cv2.drawFrameAxes(display, K, dist, rvec, tvec, SQUARE_LENGTH_M * 3)
                    last_pose = (rvec, tvec)
                detected = rvec is not None
                detected_state["ok"] = detected

                hud_mode = "PAROL6 readback ('c' to capture)" if use_robot_readback else "manual entry"
                cv2.putText(
                    display,
                    f"samples: {len(samples)} / {SETTINGS.min_samples}  markers: {n_markers}  corners: {n_corners}  [{hud_mode}]",
                    (10, 30),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.7,
                    (0, 255, 0) if detected else (0, 0, 255),
                    2,
                )
                cv2.imshow(SETTINGS.window_name, display)

                if pending_angles is not None:
                    if not detected or last_pose is None:
                        print("  -> board not detected in current frame, sample skipped.")
                    else:
                        T_bg = parol6_fk(pending_angles, robot=parol6_robot)
                        rv, tv = last_pose
                        samples.append(
                            Sample(
                                joints_deg=pending_angles.copy(),
                                T_base_gripper=T_bg,
                                rvec_target_cam=rv.copy(),
                                tvec_target_cam=tv.copy(),
                            )
                        )
                        print(
                            f"  -> sample {len(samples)} captured. "
                            f"Gripper xyz (mm): {(T_bg[:3,3]*1000).round(1).tolist()}, "
                            f"board dist: {np.linalg.norm(tv)*1000:.1f} mm"
                        )

                key = cv2.waitKey(1) & 0xFF
                if key == ord("q"):
                    break
                if key == ord("s"):
                    solve_and_save(samples)
                    return
                if key == ord("c"):
                    capture_from_robot()
                if key == ord("x") and samples:
                    samples.pop()
                    print(f"Dropped last sample, now {len(samples)} remaining.")
        finally:
            reader_stop.set()
            reader_thread.join(timeout=2.0)
            camera.set_streaming(False)
            if prompt is not None:
                prompt.stop()
            _disconnect_parol6(parol6_robot, parol6_client)

    print(f"Exited with {len(samples)} samples (no save).")


if __name__ == "__main__":
    main()
