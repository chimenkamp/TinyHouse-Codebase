    <bpmn:messageFlow id="MessageFlow_CommitAccepted" name="accepted" sourceRef="Task_SendCommitmentAccepted" targetRef="Catch_CommitmentDecision" messageRef="Message_CommitmentDecision" />
    <bpmn:messageFlow id="MessageFlow_CommitRejected" name="rejected" sourceRef="Task_SendCommitmentRejected" targetRef="Catch_CommitmentDecision" messageRef="Message_CommitmentDecision" />
    <bpmn:messageFlow id="MessageFlow_LidDispatch" name="dispatch" sourceRef="Task_DispatchLid" targetRef="Catch_LidDispatch" messageRef="Message_LidDispatch" />
    <bpmn:messageFlow id="MessageFlow_DeliveryAccepted" name="accepted" sourceRef="Task_AcceptDelivery" targetRef="Catch_DeliveryDecision" messageRef="Message_DeliveryDecision" />
    <bpmn:messageFlow id="MessageFlow_DeliveryReplacement" name="replacement" sourceRef="Task_RequestReplacement" targetRef="Catch_DeliveryDecision" messageRef="Message_DeliveryDecision" />
    <bpmn:messageFlow id="MessageFlow_Outcome" name="outcome" sourceRef="Task_ShareOutcome" targetRef="Catch_Outcome" messageRef="Message_Outcome" />
  </bpmn:collaboration>
