<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_DistributedSensorNode_Orchestration" targetNamespace="https://tinyhouse.local/bpmn/distributed-sensor-node" exporter="TinyHouse-Codebase" exporterVersion="1.0">
  <bpmn:message id="Message_LidRequest" name="Scheduled lid specification" />
  <bpmn:message id="Message_CommitmentDecision" name="Commitment decision" />
  <bpmn:message id="Message_LidDispatch" name="Lid dispatch" />
  <bpmn:message id="Message_DeliveryDecision" name="Delivery decision" />
  <bpmn:message id="Message_Outcome" name="Minimized outcome" />
  <bpmn:process id="Process_TinyHouse" name="TinyHouse (Bayreuth) orchestration" isExecutable="false">
    <bpmn:startEvent id="Start_TinyHouse" name="Run created">
      <bpmn:outgoing>Flow_T01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_RegisterRun" name="Register run">
      <bpmn:incoming>Flow_T01</bpmn:incoming>
      <bpmn:outgoing>Flow_T02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_RequestLid" name="Request matching lid" messageRef="Message_LidRequest">
      <bpmn:incoming>Flow_T04_Distributed</bpmn:incoming>
      <bpmn:outgoing>Flow_T05</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Catch_CommitmentDecision" name="Commitment">
      <bpmn:incoming>Flow_T05</bpmn:incoming>
      <bpmn:outgoing>Flow_T06</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Commitment" messageRef="Message_CommitmentDecision" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_ProduceLocally" name="Produce locally">
      <bpmn:incoming>Flow_T04_Local</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PrintBase" name="Print base">
      <bpmn:incoming>Flow_T10_Base</bpmn:incoming>
      <bpmn:incoming>Flow_R02_Print</bpmn:incoming>
      <bpmn:outgoing>Flow_T11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Task_InspectBase" name="Inspect base">
      <bpmn:incoming>Flow_T11</bpmn:incoming>
      <bpmn:outgoing>Flow_T12</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_BaseQuality" name="Base passed?" default="Flow_T13_Review">
      <bpmn:incoming>Flow_T12</bpmn:incoming>
      <bpmn:outgoing>Flow_T13_Passed</bpmn:outgoing>
      <bpmn:outgoing>Flow_T13_Review</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_BaseDisposition" name="Reprint?" default="Flow_T15_Release">
      <bpmn:incoming>Flow_T14</bpmn:incoming>
      <bpmn:outgoing>Flow_T15_Reprint</bpmn:outgoing>
      <bpmn:outgoing>Flow_T15_Release</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_ReleaseBase" name="Release base">
      <bpmn:incoming>Flow_T15_Release</bpmn:incoming>
      <bpmn:outgoing>Flow_T16_BaseReleased</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:intermediateCatchEvent id="Catch_LidDispatch" name="Lid dispatched">
      <bpmn:incoming>Flow_T10_Remote</bpmn:incoming>
      <bpmn:incoming>Flow_T21_Replacement</bpmn:incoming>
      <bpmn:outgoing>Flow_T17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Dispatch" messageRef="Message_LidDispatch" />
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="Task_ReceiveLid" name="Receive lid">
      <bpmn:incoming>Flow_T17</bpmn:incoming>
      <bpmn:outgoing>Flow_T18</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:businessRuleTask id="Task_VerifyLid" name="Verify lid">
      <bpmn:incoming>Flow_T18</bpmn:incoming>
      <bpmn:outgoing>Flow_T19</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sendTask id="Task_RequestReplacement" name="Request replacement" messageRef="Message_DeliveryDecision">
      <bpmn:incoming>Flow_T20_Replace</bpmn:incoming>
      <bpmn:outgoing>Flow_T21_Replacement</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Task_RobotKit" name="Robot kit">
      <bpmn:incoming>Flow_T23</bpmn:incoming>
      <bpmn:outgoing>Flow_T24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Calibrate" name="Test and calibrate">
      <bpmn:incoming>Flow_T25</bpmn:incoming>
      <bpmn:incoming>Flow_T29_Reworked</bpmn:incoming>
      <bpmn:outgoing>Flow_T26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_ResolveCalibration" name="Resolve failure">
      <bpmn:incoming>Flow_T27_Failed</bpmn:incoming>
      <bpmn:outgoing>Flow_T28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ApproveDeployment" name="Approve deployment">
      <bpmn:incoming>Flow_T27_Passed</bpmn:incoming>
      <bpmn:outgoing>Flow_T30</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_OutcomeRequired" name="Shared run?" default="Flow_T30_Local">
      <bpmn:incoming>Flow_T30</bpmn:incoming>
      <bpmn:outgoing>Flow_T30_Shared</bpmn:outgoing>
      <bpmn:outgoing>Flow_T30_Local</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Task_ApplyDisclosure" name="Apply disclosure">
      <bpmn:incoming>Flow_T30_Shared</bpmn:incoming>
      <bpmn:outgoing>Flow_T31</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sendTask id="Task_ShareOutcome" name="Share outcome" messageRef="Message_Outcome">
      <bpmn:incoming>Flow_T31</bpmn:incoming>
      <bpmn:outgoing>Flow_T32</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_TinyHouse" name="Run complete">
      <bpmn:incoming>Flow_T32</bpmn:incoming>
      <bpmn:incoming>Flow_T30_Local</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_T32" sourceRef="Task_ShareOutcome" targetRef="End_TinyHouse" />
    <bpmn:sequenceFlow id="Flow_T31" sourceRef="Task_ApplyDisclosure" targetRef="Task_ShareOutcome" />
    <bpmn:sequenceFlow id="Flow_T30_Local" name="no" sourceRef="Gateway_OutcomeRequired" targetRef="End_TinyHouse" />
    <bpmn:sequenceFlow id="Flow_T30_Shared" name="yes" sourceRef="Gateway_OutcomeRequired" targetRef="Task_ApplyDisclosure">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">collaborationStatus = 'active'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T30" sourceRef="Task_ApproveDeployment" targetRef="Gateway_OutcomeRequired" />
    <bpmn:sequenceFlow id="Flow_T29_Reworked" sourceRef="Task_ReworkSensor" targetRef="Task_Calibrate" />
    <bpmn:sequenceFlow id="Flow_T28" sourceRef="Task_ResolveCalibration" targetRef="Task_ReworkSensor" />
    <bpmn:sequenceFlow id="Flow_T27_Failed" name="no" sourceRef="Gateway_Calibration" targetRef="Task_ResolveCalibration" />
    <bpmn:sequenceFlow id="Flow_T27_Passed" name="yes" sourceRef="Gateway_Calibration" targetRef="Task_ApproveDeployment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">calibrationStatus = 'passed'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T26" sourceRef="Task_Calibrate" targetRef="Gateway_Calibration" />
    <bpmn:sequenceFlow id="Flow_T25" sourceRef="Task_AssembleNode" targetRef="Task_Calibrate" />
    <bpmn:sequenceFlow id="Flow_T24" sourceRef="Task_RobotKit" targetRef="Task_AssembleNode" />
    <bpmn:sequenceFlow id="Flow_T23" sourceRef="Gateway_ProductionMerge" targetRef="Task_RobotKit" />
    <bpmn:sequenceFlow id="Flow_T22_DistributedDone" sourceRef="Gateway_ProductionJoin" targetRef="Gateway_ProductionMerge" />
    <bpmn:sequenceFlow id="Flow_T21_Replacement" sourceRef="Task_RequestReplacement" targetRef="Catch_LidDispatch" />
    <bpmn:sequenceFlow id="Flow_T21_Accepted" sourceRef="Task_AcceptDelivery" targetRef="Gateway_ProductionJoin" />
    <bpmn:sequenceFlow id="Flow_T20_Replace" name="no" sourceRef="Gateway_LidQuality" targetRef="Task_RequestReplacement" />
    <bpmn:sequenceFlow id="Flow_T20_Accept" name="yes" sourceRef="Gateway_LidQuality" targetRef="Task_AcceptDelivery">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">lidQuality = 'accepted'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T19" sourceRef="Task_VerifyLid" targetRef="Gateway_LidQuality" />
    <bpmn:sequenceFlow id="Flow_T18" sourceRef="Task_ReceiveLid" targetRef="Task_VerifyLid" />
    <bpmn:sequenceFlow id="Flow_T17" sourceRef="Catch_LidDispatch" targetRef="Task_ReceiveLid" />
    <bpmn:sequenceFlow id="Flow_T16_BaseReady" sourceRef="Gateway_BaseMerge" targetRef="Gateway_ProductionJoin" />
    <bpmn:sequenceFlow id="Flow_T16_BaseReleased" sourceRef="Task_ReleaseBase" targetRef="Gateway_BaseMerge" />
    <bpmn:sequenceFlow id="Flow_T15_Release" name="no" sourceRef="Gateway_BaseDisposition" targetRef="Task_ReleaseBase" />
    <bpmn:sequenceFlow id="Flow_T15_Reprint" name="yes" sourceRef="Gateway_BaseDisposition" targetRef="Task_ScheduleReprint">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">baseDisposition = 'reprint'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_R01" sourceRef="Task_ScheduleReprint" targetRef="Gateway_ReprintEnergy" />
    <bpmn:sequenceFlow id="Flow_R02_Print" name="yes" sourceRef="Gateway_ReprintEnergy" targetRef="Task_PrintBase">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">availableRenewableEnergyKWh &gt;= reprintEnergyKWh + reserveEnergyKWh</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_R02_Wait" name="no" sourceRef="Gateway_ReprintEnergy" targetRef="Catch_ReprintSolarWindow" />
    <bpmn:sequenceFlow id="Flow_R03_Retry" sourceRef="Catch_ReprintSolarWindow" targetRef="Task_ScheduleReprint" />
    <bpmn:sequenceFlow id="Flow_T14" sourceRef="Task_ReviewBase" targetRef="Gateway_BaseDisposition" />
    <bpmn:sequenceFlow id="Flow_T13_Review" name="no" sourceRef="Gateway_BaseQuality" targetRef="Task_ReviewBase" />
    <bpmn:sequenceFlow id="Flow_T13_Passed" name="yes" sourceRef="Gateway_BaseQuality" targetRef="Gateway_BaseMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">baseQuality = 'accepted'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T12" sourceRef="Task_InspectBase" targetRef="Gateway_BaseQuality" />
    <bpmn:sequenceFlow id="Flow_T11" sourceRef="Task_PrintBase" targetRef="Task_InspectBase" />
    <bpmn:sequenceFlow id="Flow_T10_Remote" sourceRef="Gateway_ProductionSplit" targetRef="Catch_LidDispatch" />
    <bpmn:sequenceFlow id="Flow_T10_Base" sourceRef="Gateway_ProductionSplit" targetRef="Task_PrintBase" />
    <bpmn:sequenceFlow id="Flow_T08_Rejected" name="rejected" sourceRef="Gateway_Commitment" targetRef="Task_SetLocalFallback" />
    <bpmn:sequenceFlow id="Flow_T08_Accepted" name="accepted" sourceRef="Gateway_Commitment" targetRef="Gateway_ProductionSplit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">commitmentStatus = 'accepted'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_T07" sourceRef="Task_EvaluateCommitment" targetRef="Gateway_Commitment" />
    <bpmn:sequenceFlow id="Flow_T06" sourceRef="Catch_CommitmentDecision" targetRef="Task_EvaluateCommitment" />
    <bpmn:sequenceFlow id="Flow_T05" sourceRef="Task_RequestLid" targetRef="Catch_CommitmentDecision" />
    <bpmn:sequenceFlow id="Flow_T04_Local" name="no" sourceRef="Gateway_Topology" targetRef="Task_ProduceLocally" />
    <bpmn:sequenceFlow id="Flow_T04_Distributed" name="yes" sourceRef="Gateway_Topology" targetRef="Task_RequestLid">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">topology = 'distributed'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_F01_Reschedule" sourceRef="Task_SetLocalFallback" targetRef="Task_ReadEnergyState" />
    <bpmn:sequenceFlow id="Flow_E06_Retry" sourceRef="Catch_NextSolarWindow" targetRef="Task_ReadEnergyState" />
    <bpmn:sequenceFlow id="Flow_E05_Configured" sourceRef="Gateway_ConfigurationMerge" targetRef="Gateway_Topology" />
    <bpmn:sequenceFlow id="Flow_E04_Standard" sourceRef="Task_SetStandardConfiguration" targetRef="Gateway_ConfigurationMerge" />
    <bpmn:sequenceFlow id="Flow_E04_Large" sourceRef="Task_SetLargeConfiguration" targetRef="Gateway_ConfigurationMerge" />
    <bpmn:sequenceFlow id="Flow_E03_Wait" name="wait" sourceRef="Gateway_EnergyBudget" targetRef="Catch_NextSolarWindow" />
    <bpmn:sequenceFlow id="Flow_E03_Standard" name="standard" sourceRef="Gateway_EnergyBudget" targetRef="Task_SetStandardConfiguration">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">availableRenewableEnergyKWh &gt;= standardContainerEnergyKWh + reserveEnergyKWh and availableRenewableEnergyKWh &lt; largeContainerEnergyKWh + reserveEnergyKWh</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_E03_Large" name="large" sourceRef="Gateway_EnergyBudget" targetRef="Task_SetLargeConfiguration">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">availableRenewableEnergyKWh &gt;= largeContainerEnergyKWh + reserveEnergyKWh</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_E02" sourceRef="Task_ScheduleProduction" targetRef="Gateway_EnergyBudget" />
    <bpmn:sequenceFlow id="Flow_E01" sourceRef="Task_ReadEnergyState" targetRef="Task_ScheduleProduction" />
    <bpmn:sequenceFlow id="Flow_T03" sourceRef="Task_SelectTopology" targetRef="Task_ReadEnergyState" />
    <bpmn:sequenceFlow id="Flow_T02" sourceRef="Task_RegisterRun" targetRef="Task_SelectTopology" />
    <bpmn:sequenceFlow id="Flow_T01" sourceRef="Start_TinyHouse" targetRef="Task_RegisterRun" />
    <bpmn:businessRuleTask id="Task_EvaluateCommitment" name="Evaluate decision">
      <bpmn:incoming>Flow_T06</bpmn:incoming>
      <bpmn:outgoing>Flow_T07</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="Task_SetStandardConfiguration" name="Select standard container">
      <bpmn:incoming>Flow_E03_Standard</bpmn:incoming>
      <bpmn:outgoing>Flow_E04_Standard</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_Commitment" name="Accepted?" default="Flow_T08_Rejected">
      <bpmn:incoming>Flow_T07</bpmn:incoming>
      <bpmn:outgoing>Flow_T08_Accepted</bpmn:outgoing>
      <bpmn:outgoing>Flow_T08_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Task_SetLocalFallback" name="Set local fallback">
      <bpmn:incoming>Flow_T08_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_F01_Reschedule</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:intermediateCatchEvent id="Catch_ReprintSolarWindow" name="Next solar window">
      <bpmn:incoming>Flow_R02_Wait</bpmn:incoming>
      <bpmn:outgoing>Flow_R03_Retry</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_ReprintSolarWindow">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">nextSolarWindowStart</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_AssembleNode" name="Assemble node">
      <bpmn:incoming>Flow_T24</bpmn:incoming>
      <bpmn:outgoing>Flow_T25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ReworkSensor" name="Rework sensor">
      <bpmn:incoming>Flow_T28</bpmn:incoming>
      <bpmn:outgoing>Flow_T29_Reworked</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Calibration" name="Passed?" default="Flow_T27_Failed">
      <bpmn:incoming>Flow_T26</bpmn:incoming>
      <bpmn:outgoing>Flow_T27_Passed</bpmn:outgoing>
      <bpmn:outgoing>Flow_T27_Failed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Task_ScheduleReprint" name="Schedule reprint energy">
      <bpmn:incoming>Flow_T15_Reprint</bpmn:incoming>
      <bpmn:incoming>Flow_R03_Retry</bpmn:incoming>
      <bpmn:outgoing>Flow_R01</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_LidQuality" name="Lid passed?" default="Flow_T20_Replace">
      <bpmn:incoming>Flow_T19</bpmn:incoming>
      <bpmn:outgoing>Flow_T20_Accept</bpmn:outgoing>
      <bpmn:outgoing>Flow_T20_Replace</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_Topology" name="Distributed?" default="Flow_T04_Local">
      <bpmn:incoming>Flow_E05_Configured</bpmn:incoming>
      <bpmn:outgoing>Flow_T04_Distributed</bpmn:outgoing>
      <bpmn:outgoing>Flow_T04_Local</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Task_ScheduleProduction" name="Optimize energy-aware schedule">
      <bpmn:incoming>Flow_E01</bpmn:incoming>
      <bpmn:outgoing>Flow_E02</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_EnergyBudget" name="Renewable energy available?" default="Flow_E03_Wait">
      <bpmn:incoming>Flow_E02</bpmn:incoming>
      <bpmn:outgoing>Flow_E03_Large</bpmn:outgoing>
      <bpmn:outgoing>Flow_E03_Standard</bpmn:outgoing>
      <bpmn:outgoing>Flow_E03_Wait</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Catch_NextSolarWindow" name="Next solar window">
      <bpmn:incoming>Flow_E03_Wait</bpmn:incoming>
      <bpmn:outgoing>Flow_E06_Retry</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_NextSolarWindow">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">nextSolarWindowStart</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Task_AcceptDelivery" name="Accept delivery" messageRef="Message_DeliveryDecision">
      <bpmn:incoming>Flow_T20_Accept</bpmn:incoming>
      <bpmn:outgoing>Flow_T21_Accepted</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:businessRuleTask id="Task_SetLargeConfiguration" name="Select large container">
      <bpmn:incoming>Flow_E03_Large</bpmn:incoming>
      <bpmn:outgoing>Flow_E04_Large</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_ConfigurationMerge" gatewayDirection="Converging">
      <bpmn:incoming>Flow_E04_Large</bpmn:incoming>
      <bpmn:incoming>Flow_E04_Standard</bpmn:incoming>
      <bpmn:outgoing>Flow_E05_Configured</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ReadEnergyState" name="Read solar and battery">
      <bpmn:incoming>Flow_T03</bpmn:incoming>
      <bpmn:incoming>Flow_E06_Retry</bpmn:incoming>
      <bpmn:incoming>Flow_F01_Reschedule</bpmn:incoming>
      <bpmn:outgoing>Flow_E01</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_ProductionSplit" name="Split production" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_T08_Accepted</bpmn:incoming>
      <bpmn:outgoing>Flow_T10_Base</bpmn:outgoing>
      <bpmn:outgoing>Flow_T10_Remote</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_ReviewBase" name="Review base">
      <bpmn:incoming>Flow_T13_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_T14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_BaseMerge" gatewayDirection="Converging">
      <bpmn:incoming>Flow_T13_Passed</bpmn:incoming>
      <bpmn:incoming>Flow_T16_BaseReleased</bpmn:incoming>
      <bpmn:outgoing>Flow_T16_BaseReady</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_ReprintEnergy" name="Reprint energy available?" default="Flow_R02_Wait">
      <bpmn:incoming>Flow_R01</bpmn:incoming>
      <bpmn:outgoing>Flow_R02_Print</bpmn:outgoing>
      <bpmn:outgoing>Flow_R02_Wait</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_ProductionJoin" name="Parts ready" gatewayDirection="Converging">
      <bpmn:incoming>Flow_T16_BaseReady</bpmn:incoming>
      <bpmn:incoming>Flow_T21_Accepted</bpmn:incoming>
      <bpmn:outgoing>Flow_T22_DistributedDone</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_ProductionMerge" gatewayDirection="Converging">
      <bpmn:incoming>Flow_T22_DistributedDone</bpmn:incoming>
      <bpmn:outgoing>Flow_T23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Task_SelectTopology" name="Select topology">
      <bpmn:incoming>Flow_T02</bpmn:incoming>
      <bpmn:outgoing>Flow_T03</bpmn:outgoing>
    </bpmn:businessRuleTask>
  </bpmn:process>
  <bpmn:process id="Process_Munich" name="Munich orchestration" isExecutable="false">
    <bpmn:startEvent id="Start_Munich" name="Lid requested">
      <bpmn:outgoing>Flow_M01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Request" messageRef="Message_LidRequest" />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_AssessCommitment" name="Assess commitment">
      <bpmn:incoming>Flow_M01</bpmn:incoming>
      <bpmn:outgoing>Flow_M02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_AcceptCommitment" name="Accept?" default="Flow_M03_Reject">
      <bpmn:incoming>Flow_M02</bpmn:incoming>
      <bpmn:outgoing>Flow_M03_Accept</bpmn:outgoing>
      <bpmn:outgoing>Flow_M03_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_SendCommitmentAccepted" name="Accept commitment" messageRef="Message_CommitmentDecision">
      <bpmn:incoming>Flow_M03_Accept</bpmn:incoming>
      <bpmn:outgoing>Flow_M04_Accepted</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Task_SendCommitmentRejected" name="Reject commitment" messageRef="Message_CommitmentDecision">
      <bpmn:incoming>Flow_M03_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_M04_Rejected</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_MunichRejected" name="Commitment closed">
      <bpmn:incoming>Flow_M04_Rejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_PrintLid" name="Print lid">
      <bpmn:incoming>Flow_M04_Configured</bpmn:incoming>
      <bpmn:incoming>Flow_M09_Reprint</bpmn:incoming>
      <bpmn:incoming>Flow_M15_Replacement</bpmn:incoming>
      <bpmn:outgoing>Flow_M05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Task_InspectLid" name="Inspect lid">
      <bpmn:incoming>Flow_M05</bpmn:incoming>
      <bpmn:outgoing>Flow_M06</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_MunichQuality" name="Lid passed?" default="Flow_M07_Review">
      <bpmn:incoming>Flow_M06</bpmn:incoming>
      <bpmn:outgoing>Flow_M07_Passed</bpmn:outgoing>
      <bpmn:outgoing>Flow_M07_Review</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ReviewLid" name="Review lid">
      <bpmn:incoming>Flow_M07_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_M08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_MunichDisposition" name="Reprint?" default="Flow_M09_Release">
      <bpmn:incoming>Flow_M08</bpmn:incoming>
      <bpmn:outgoing>Flow_M09_Reprint</bpmn:outgoing>
      <bpmn:outgoing>Flow_M09_Release</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_PackLid" name="Pack lid">
      <bpmn:incoming>Flow_M07_Passed</bpmn:incoming>
      <bpmn:incoming>Flow_M10_Released</bpmn:incoming>
      <bpmn:outgoing>Flow_M11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_DispatchLid" name="Dispatch lid" messageRef="Message_LidDispatch">
      <bpmn:incoming>Flow_M11</bpmn:incoming>
      <bpmn:outgoing>Flow_M12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Catch_DeliveryDecision" name="Delivery decision">
      <bpmn:incoming>Flow_M12</bpmn:incoming>
      <bpmn:outgoing>Flow_M13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Delivery" messageRef="Message_DeliveryDecision" />
    </bpmn:intermediateCatchEvent>
    <bpmn:businessRuleTask id="Task_EvaluateDelivery" name="Evaluate delivery">
      <bpmn:incoming>Flow_M13</bpmn:incoming>
      <bpmn:outgoing>Flow_M14</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_DeliveryAccepted" name="Accepted?" default="Flow_M15_Replacement">
      <bpmn:incoming>Flow_M14</bpmn:incoming>
      <bpmn:outgoing>Flow_M15_Accepted</bpmn:outgoing>
      <bpmn:outgoing>Flow_M15_Replacement</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Catch_Outcome" name="Outcome received">
      <bpmn:incoming>Flow_M15_Accepted</bpmn:incoming>
      <bpmn:outgoing>Flow_M16</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Outcome" messageRef="Message_Outcome" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_MunichComplete" name="Collaboration complete">
      <bpmn:incoming>Flow_M16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_M01" sourceRef="Start_Munich" targetRef="Task_AssessCommitment" />
    <bpmn:sequenceFlow id="Flow_M02" sourceRef="Task_AssessCommitment" targetRef="Gateway_AcceptCommitment" />
    <bpmn:sequenceFlow id="Flow_M03_Accept" name="yes" sourceRef="Gateway_AcceptCommitment" targetRef="Task_SendCommitmentAccepted">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">capacityDecision = 'accepted'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_M03_Reject" name="no" sourceRef="Gateway_AcceptCommitment" targetRef="Task_SendCommitmentRejected" />
    <bpmn:sequenceFlow id="Flow_M04_Accepted" sourceRef="Task_SendCommitmentAccepted" targetRef="Task_ConfigureLid" />
    <bpmn:sequenceFlow id="Flow_M04_Configured" sourceRef="Task_ConfigureLid" targetRef="Task_PrintLid" />
    <bpmn:sequenceFlow id="Flow_M04_Rejected" sourceRef="Task_SendCommitmentRejected" targetRef="End_MunichRejected" />
    <bpmn:sequenceFlow id="Flow_M05" sourceRef="Task_PrintLid" targetRef="Task_InspectLid" />
    <bpmn:sequenceFlow id="Flow_M06" sourceRef="Task_InspectLid" targetRef="Gateway_MunichQuality" />
    <bpmn:sequenceFlow id="Flow_M07_Passed" name="yes" sourceRef="Gateway_MunichQuality" targetRef="Task_PackLid">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">lidQuality = 'accepted'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_M07_Review" name="no" sourceRef="Gateway_MunichQuality" targetRef="Task_ReviewLid" />
    <bpmn:sequenceFlow id="Flow_M08" sourceRef="Task_ReviewLid" targetRef="Gateway_MunichDisposition" />
    <bpmn:sequenceFlow id="Flow_M09_Reprint" name="yes" sourceRef="Gateway_MunichDisposition" targetRef="Task_PrintLid">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">lidDisposition = 'reprint'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_M09_Release" name="no" sourceRef="Gateway_MunichDisposition" targetRef="Task_ReleaseLid" />
    <bpmn:sequenceFlow id="Flow_M10_Released" sourceRef="Task_ReleaseLid" targetRef="Task_PackLid" />
    <bpmn:sequenceFlow id="Flow_M11" sourceRef="Task_PackLid" targetRef="Task_DispatchLid" />
    <bpmn:sequenceFlow id="Flow_M12" sourceRef="Task_DispatchLid" targetRef="Catch_DeliveryDecision" />
    <bpmn:sequenceFlow id="Flow_M13" sourceRef="Catch_DeliveryDecision" targetRef="Task_EvaluateDelivery" />
    <bpmn:sequenceFlow id="Flow_M14" sourceRef="Task_EvaluateDelivery" targetRef="Gateway_DeliveryAccepted" />
    <bpmn:sequenceFlow id="Flow_M15_Accepted" name="yes" sourceRef="Gateway_DeliveryAccepted" targetRef="Catch_Outcome">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">deliveryStatus = 'accepted'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_M15_Replacement" name="no" sourceRef="Gateway_DeliveryAccepted" targetRef="Task_PrintLid" />
    <bpmn:sequenceFlow id="Flow_M16" sourceRef="Catch_Outcome" targetRef="End_MunichComplete" />
    <bpmn:businessRuleTask id="Task_ConfigureLid" name="Configure utility lid">
      <bpmn:incoming>Flow_M04_Accepted</bpmn:incoming>
      <bpmn:outgoing>Flow_M04_Configured</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:manualTask id="Task_ReleaseLid" name="Release lid">
      <bpmn:incoming>Flow_M09_Release</bpmn:incoming>
      <bpmn:outgoing>Flow_M10_Released</bpmn:outgoing>
    </bpmn:manualTask>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_DistributedSensorNode">
    <bpmn:participant id="Participant_TinyHouse" name="TinyHouse (Bayreuth)" processRef="Process_TinyHouse" />
